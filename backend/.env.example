# ── LLM (Groq — free at console.groq.com) ────────────────────────────────────
GROQ_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Google (Calendar + Gmail) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Paste the full token JSON (from oauth flow) as a single-line string
GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"..."}

# Optional: separate calendar IDs for each rep (defaults to their email)
ARJUN_CALENDAR_ID=arjun@nexusanalytics.in
PRIYA_CALENDAR_ID=priya@nexusanalytics.in

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886      # Twilio sandbox number (main bot)
WHATSAPP_DEV_NUMBER=+91XXXXXXXXXX        # YOUR personal number — shows as "whatsapp_dev" in dashboard

# ── Instagram (coming soon — keep token ready for when Meta approves) ─────────
META_VERIFY_TOKEN=nexus_verify_123       # keep this, webhook endpoint is live
